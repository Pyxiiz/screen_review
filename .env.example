# Copy this file to `.env` in the same directory and set values.
# `.env` is gitignored; never commit real keys.
#
# OpenAI (or compatible API using chat/completions) — required for stage1 / stage2 / run
OPENAI_API_KEY=

# Optional: NCBI E-utilities — higher rate limits for enrich-pubmed
NCBI_API_KEY=
